{
  "name": "moneycoming",
  "version": "1.0.4",
  "private": true,
  "description": "豆粕离线历史看盘",
  "author": "MoneyComing",
  "type": "module",
  "main": "build/main.cjs",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build && node scripts/build-electron.mjs",
    "start": "electron .",
    "package": "npm run build && electron-builder --win nsis --publish never",
    "verify:tag": "node scripts/verify-tag-version.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:security": "node scripts/verify-credentials.mjs",
    "verify:public-release": "node scripts/verify-public-release.mjs",
    "verify:signing-path": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/verify-signing-path.ps1",
    "test:app": "node tests/app-smoke.mjs",
    "test:market-update": "node tests/market-update-smoke.mjs",
    "test:market-update-live": "node tests/market-update-live.mjs",
    "test:update": "node tests/update-smoke.mjs",
    "test:installer": "node tests/nsis-install-smoke.mjs",
    "test:upgrade-installer": "node tests/nsis-upgrade-smoke.mjs",
    "test:public-update": "node tests/public-update-e2e.mjs"
  },
  "build": {
    "appId": "local.moneycoming.viewer",
    "productName": "MoneyComing",
    "directories": {
      "output": "release"
    },
    "files": [
      "build/**/*",
      "dist/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "futures_investigation_20261009",
        "to": "data",
        "filter": [
          "edb_*_5m.csv",
          "edb_*_60m.csv",
          "summary.json",
          "cross_source_audit.json"
        ]
      },
      {
        "from": "futures_investigation_20261009/entry-rules.md",
        "to": "data/entry-rules.md"
      },
      {
        "from": "docs/使用说明.md",
        "to": "使用说明.md"
      },
      {
        "from": "docs/THIRD-PARTY-NOTICES.txt",
        "to": "THIRD-PARTY-NOTICES.txt"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "MoneyComing-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "MoneyComing",
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "yxsimony-dot",
      "repo": "MoneyComingExe",
      "releaseType": "release"
    },
    "asar": true
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "lightweight-charts": "5.2.1",
    "semver": "7.8.5"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@types/node": "26.6.4",
    "@types/semver": "7.8.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "playwright": "1.64.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
