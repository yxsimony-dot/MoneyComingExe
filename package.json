{
  "name": "moneycoming",
  "version": "1.0.9",
  "private": true,
  "description": "多品种主连离线历史看盘",
  "author": "MoneyComing",
  "type": "module",
  "main": "build/main.cjs",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build && node scripts/build-electron.mjs",
    "start": "electron .",
    "data:audit": "node scripts/audit-market-baselines.mjs",
    "data:audit:desktop-history": "node scripts/audit-desktop-futures-history.mjs",
    "data:audit:desktop-main-matches": "node scripts/audit-desktop-main-contract-matches.mjs",
    "data:audit:gap-sources": "node scripts/audit-gap-history-sources.mjs",
    "data:audit:licenses": "node scripts/audit-market-history-licenses.mjs",
    "data:audit:modelscope-conventions": "node scripts/audit-modelscope-source-conventions.mjs",
    "data:audit:public-source": "node scripts/audit-public-history-source.mjs",
    "data:candidate:desktop": "node scripts/generate-desktop-temporary-candidates.mjs",
    "data:candidate:modelscope": "node scripts/generate-modelscope-temporary-candidates.mjs",
    "data:diagnose:modelscope-calibration": "node scripts/diagnose-modelscope-calibration.mjs",
    "data:generate": "node scripts/generate-market-baselines.mjs",
    "data:probe:huggingface-domestic-futures": "node scripts/run-huggingface-domestic-futures-probe.mjs",
    "data:probe:kaggle": "node scripts/run-kaggle-high-frequency-futures-probe.mjs",
    "data:probe:modelscope": "node scripts/probe-modelscope-tick-source.mjs",
    "data:probe:modelscope:gap-samples": "node scripts/probe-modelscope-tick-source.mjs --sample-all-instruments --sample-dates 2025-07-01,2025-08-01,2025-09-01,2025-10-09",
    "data:probe:myquant-local": "node scripts/probe-myquant-local-minute.mjs",
    "data:probe:pytdx": "node scripts/run-pytdx-public-exhq-probe.mjs",
    "data:probe:sina-minute": "node scripts/probe-sina-futures-minute.mjs",
    "data:probe:tdx": "node scripts/run-tdx-tq-history-probe.mjs",
    "data:probe:tushare": "node scripts/probe-tushare-futures-minute.mjs",
    "data:validate": "node scripts/validate-market-baselines.mjs",
    "package": "npm run build && node scripts/prepare-release.mjs && electron-builder --win nsis --publish never",
    "verify:tag": "node scripts/verify-tag-version.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:security": "node scripts/verify-credentials.mjs",
    "verify:public-release": "node scripts/verify-public-release.mjs",
    "verify:signing-path": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/verify-signing-path.ps1",
    "test:app": "node tests/app-smoke.mjs",
    "test:real-baseline": "node tests/real-baseline-offline-smoke.mjs",
    "test:offscreen-window": "node tests/offscreen-production-mode-smoke.mjs",
    "test:market-update": "node tests/market-update-smoke.mjs",
    "test:online-market": "node tests/online-market-smoke.mjs",
    "test:online-performance": "node scripts/measure-online-tail-performance.mjs",
    "test:history-extension-performance": "node scripts/measure-history-extension-performance.mjs",
    "report:history-extension-acceptance": "node scripts/generate-history-extension-final-acceptance.mjs",
    "test:market-update-live": "node tests/market-update-live.mjs",
    "test:update": "node tests/update-smoke.mjs",
    "test:installer": "node tests/nsis-install-smoke.mjs",
    "test:upgrade-installer": "node tests/nsis-upgrade-smoke.mjs",
    "test:public-update": "node tests/public-update-e2e.mjs"
  },
  "build": {
    "appId": "local.moneycoming.viewer",
    "productName": "MoneyComing",
    "directories": {
      "output": "release"
    },
    "files": [
      "build/**/*",
      "dist/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "data",
        "to": "data",
        "filter": [
          "instruments/**/*",
          "baseline-report.json",
          "baseline-validation-report.json"
        ]
      },
      {
        "from": "futures_investigation_20261009/entry-rules.md",
        "to": "data/entry-rules.md"
      },
      {
        "from": "docs/使用说明.md",
        "to": "使用说明.md"
      },
      {
        "from": "docs/THIRD-PARTY-NOTICES.txt",
        "to": "THIRD-PARTY-NOTICES.txt"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "MoneyComing-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "MoneyComing",
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "yxsimony-dot",
      "repo": "MoneyComingExe",
      "releaseType": "release"
    },
    "asar": true
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "lightweight-charts": "5.2.1",
    "semver": "7.8.5",
    "unzipper": "^0.12.5"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@types/node": "26.6.4",
    "@types/semver": "7.8.0",
    "@types/unzipper": "^0.10.11",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "playwright": "1.64.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
